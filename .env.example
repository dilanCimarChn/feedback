GEMINI_API_KEY=
# Opcional: modelo preferido de Gemini (si falla se prueban los de respaldo)
GEMINI_MODEL=
# Opcional: si se define, la herramienta pedirá este código antes de usarse
APP_ACCESS_CODE=
# Opcional: YouTube Data API v3 habilitada, búsqueda por tema (últimos 7 días)
# Sin tema usa selección popular. No entrega ubicación ni horas de audiencia.
# Cuota default: 100 búsquedas/día (bolsa separada); videos.list cuesta 1 unidad.
YOUTUBE_API_KEY=

# Conexiones sociales de lectura: tokens autorizados, nunca usar prefijo VITE_
# Meta: versión vigente de Graph API (formato vNN.N), sin valor implícito
META_GRAPH_VERSION=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Opcional: hasta 2 cuentas profesionales públicas para Business Discovery,
# separadas por coma, sin @ ni URL. Requiere permisos/aprobación de Meta.
# Sin cuentas se propone 1 hashtag por tema; máximo 2 hashtags por consulta.
# Hashtag Search requiere Instagram Public Content Access/App Review.
INSTAGRAM_DISCOVERY_HASHTAGS=
INSTAGRAM_DISCOVERY_ACCOUNTS=
# Compatibilidad: INSTAGRAM_CUENTAS_REFERENCIA sigue aceptada si no se define DISCOVERY_ACCOUNTS.
# Facebook externo: páginas públicas de referencia y acceso aprobado (no token propio).
FACEBOOK_DISCOVERY_PAGE_IDS=
FACEBOOK_PUBLIC_ACCESS_TOKEN=
# TikTok Discovery: permiso discovery.search.words; BUSINESS_ID = open_id del OAuth.
# No reutilizar el token de Display API ni el ID del anunciante.
TIKTOK_DISCOVERY_ACCESS_TOKEN=
TIKTOK_DISCOVERY_BUSINESS_ID=
# TikTok Display API: token de usuario con permiso video.list
TIKTOK_ACCESS_TOKEN=
# X excluido en el código para evitar consumo de pago, incluso con token presente.
# Se conserva el nombre por compatibilidad; dejar vacío. No activa consultas.
X_BEARER_TOKEN=
# LinkedIn: organización administrada, permiso r_organization_social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Versión vigente en formato AAAAMM
LINKEDIN_VERSION=

# Campañas compartidas: Blob privado y código del equipo (solo backend).
# La integración de almacenamiento de Vercel configura el token en Production.
BLOB_READ_WRITE_TOKEN=
# Alternativa oficial al token: BLOB_STORE_ID + VERCEL_OIDC_TOKEN del entorno.
EQUIPO_CODIGO_ACCESO=
