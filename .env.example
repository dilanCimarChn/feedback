GEMINI_API_KEY=
# Opcional: modelo preferido de Gemini (si falla se prueban los de respaldo)
GEMINI_MODEL=
# Opcional: si se define, la herramienta pedirá este código antes de usarse
APP_ACCESS_CODE=
# Opcional: YouTube Data API v3 habilitada, para señales públicas por país
YOUTUBE_API_KEY=

# Conexiones sociales de lectura: tokens autorizados, nunca usar prefijo VITE_
# Meta: versión vigente de Graph API (formato vNN.N), sin valor implícito
META_GRAPH_VERSION=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# TikTok Display API: token de usuario con permiso video.list
TIKTOK_ACCESS_TOKEN=
# X: bearer de aplicación con acceso a búsqueda reciente (según plan/cuota)
X_BEARER_TOKEN=
# LinkedIn: organización administrada, permiso r_organization_social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Versión vigente en formato AAAAMM
LINKEDIN_VERSION=
